{
  // Cloudflare Workers with static assets (no Worker script needed: the site is plain files).
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "distractedquest-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /privacy serves privacy.html; /privacy.html and /privacy/ redirect to /privacy.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a real 404 status.
    "not_found_handling": "404-page"
  }
}
