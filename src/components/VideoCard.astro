---
import type { Video } from '../lib/videos';
import { fmtDate } from '../lib/videos';
import Icon from './Icon.astro';
import site from '../data/site.json';
interface Props { video: Video; eager?: boolean }
const { video: v, eager = false } = Astro.props;
import { topicLabel as label, topicsOf, topicStyle } from '../lib/topics';
const vt = topicsOf(v);
---
<article class:list={['card', { short: v.isShort }]} data-topics={vt.join(' ')} data-kind={v.isShort ? 'short' : 'video'}>
  <a class="thumb" href={`/videos/${v.slug}`} aria-label={v.title}>
    {v.thumbnail ? (
      <img src={v.thumbnail} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width={v.isShort ? 405 : 480} height={v.isShort ? 720 : 270} />
    ) : (
      <span class="placeholder-thumb">{v.title}</span>
    )}
    <span class="play"><Icon name="play" /></span>
  </a>
  <div class="body">
    <h3><a href={`/videos/${v.slug}`}>{v.title}</a></h3>
    <div class="meta">
      <time datetime={v.published}>{fmtDate(v.published)}</time>
      {v.isShort && <span class="tag">Short</span>}
      {vt.map((t) => <span class:list={['tag', t]} style={topicStyle(t)}>{label(t)}</span>)}
    </div>
  </div>
</article>
