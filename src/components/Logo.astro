---
// Placeholder mark: a compass-rose / lure badge. Swap for the channel logo from Chopper (public/logo.svg) later.
interface Props { class?: string; size?: number }
import site from '../data/site.json';
const { class: cls, size } = Astro.props;
// With heroVariant "logo", use the real channel logo (public/brand/logo.jpg, from the YouTube/X profile picture).
const useBrand = (process.env.DQ_HERO || (site as any).heroVariant) === 'logo';
---
{useBrand ? <img src="/brand/logo.jpg" class:list={[cls, 'brand-logo']} width={size ?? 36} height={size ?? 36} alt="" /> :
<svg viewBox="0 0 64 64" class={cls} width={size} height={size} aria-hidden="true">
  <defs>
    <linearGradient id="dq-g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6c28b"/><stop offset=".48" stop-color="#e8833a"/><stop offset=".5" stop-color="#1f6f5c"/><stop offset="1" stop-color="#134a3e"/>
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="30" fill="url(#dq-g)"/>
  <circle cx="32" cy="30" r="8" fill="#fff6e8" opacity=".95"/>
  <path d="M4 34c6-3 10-3 14 0s8 3 14 0 10-3 14 0 8 3 14 0" fill="none" stroke="#fff6e8" stroke-width="2.4" stroke-linecap="round" opacity=".9"/>
  <path d="M8 44c6-3 10-3 14 0s8 3 14 0 10-3 14 0 6 2 8 1" fill="none" stroke="#fff6e8" stroke-width="2" stroke-linecap="round" opacity=".55"/>
  <circle cx="32" cy="32" r="30" fill="none" stroke="#fff6e8" stroke-opacity=".35" stroke-width="2"/>
</svg>
}
